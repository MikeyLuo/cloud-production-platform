---
interface Props {
  title: string;
  section: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
import PageViewCounter from '../components/PageViewCounter.astro';
import ContactLinks from '../components/ContactLinks.astro';

const { title, section } = Astro.props;

{/*const navigation = [
  { slug: 'about', title: 'Email' },
  { slug: 'resume', title: 'Resume' },
  { slug: 'projects', title: 'Projects' },
  { slug: 'travel', title: 'Travel Blog' },
];*/}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={`${title} — Michael Luong’s portfolio.`}
    />
    <title>{title} | Michael Luong</title>
  </head>

  <body>
    <a class="skip-link" href="#content">Skip to content</a>

    <div class="frame">
      <header>
        <a class="wordmark" href={`${base}/`} aria-label="Michael Luong, home">
          <span aria-hidden="true">&gt;_</span> Michael Luong
        </a>

        <ContactLinks />
      </header>

      <main id="content" tabindex="-1">
        <a class="back-link" href={`${base}/`}>← Mission Control</a>
        <h1>{title}</h1>
        <slot />
        <footer>
          <PageViewCounter />
        </footer>
      </main>
    </div>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background: #0d131f;
    color: #f0f5ff;
    font: 0.9375rem/1.5 Arial, sans-serif;
  }

  .frame {
    max-width: 62rem;
    margin-inline: auto;
    overflow: hidden;
    border-radius: 0.875rem;
    box-shadow: inset 0 0 0 1px #314359;
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.65rem 1.25rem;
    min-height: 63px;
    box-sizing: border-box;
    padding: 0.75rem clamp(1.1875rem, 3.5vw, 2.25rem);
    border-bottom: 1px solid #29384d;
    background: #101824;
  }

  a {
    color: #b5c7e1;
    text-decoration: none;
  }

  a:hover,
  a[aria-current="page"] {
    color: #a4ffdc;
  }

  a[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 0.4em;
  }

  a:focus-visible {
    outline: 2px solid #a4ffdc;
    outline-offset: 4px;
    border-radius: 3px;
  }

  .wordmark {
    display: inline-flex;
    gap: 0.6rem;
    color: #f0f5ff;
    font: bold 0.75rem/1.4 "Courier New", monospace;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .wordmark span {
    color: #a4ffdc;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-block;
    padding-block: 0.375rem;
    font-size: 0.8125rem;
  }

  main {
    padding: 1.5rem clamp(1.1875rem, 3.5vw, 2.25rem) 2rem;
    background:
      radial-gradient(circle, #26384c 1px, transparent 1.25px)
      -4px 0 / 22px 22px;
  }

  .back-link {
    font: 0.8125rem/1.5 "Courier New", monospace;
  }

  h1 {
    margin: 1rem 0 1.25rem;
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.04em;
  }

  .skip-link {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 10;
    padding: 0.5rem 0.75rem;
    background: #101824;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  @media (max-width: 30rem) {
    header {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  footer{
    margin-top: 1.5rem;
  }

</style>