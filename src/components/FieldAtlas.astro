</field-atlas>

<script>
  class FieldAtlas extends HTMLElement {
    connectedCallback() {
      this.addEventListener('click', this.selectCountry);
    }

    disconnectedCallback() {
      this.removeEventListener('click', this.selectCountry);
    }

    selectCountry = (event: MouseEvent) => {
      if (!(event.target instanceof Element)) return;

      const selected = event.target.closest<HTMLButtonElement>('button[data-country]');
      const heading = this.querySelector('[data-selected-name]');
      if (!selected || !heading || selected.getAttribute('aria-pressed') === 'true') return;

      this.querySelectorAll<HTMLButtonElement>('button[data-country]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.country === selected.dataset.country));
      });
      heading.textContent = selected.dataset.name ?? '';
    };
  }

  if (!customElements.get('field-atlas')) {
    customElements.define('field-atlas', FieldAtlas);
  }
</script>

<style>
  field-atlas {
    display: block;
    color: #203b32;
    font-family: "DM Sans", system-ui, sans-serif;
  }

  section {
    --ink: #203b32;
