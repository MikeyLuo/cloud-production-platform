---
const resumeUrl =
  `${import.meta.env.BASE_URL.replace(/\/$/, '')}/documents/Michael_Luong_Resume.pdf`;
---

<section aria-label="Resume document">
  <div class="actions">
    <a href={resumeUrl} target="_blank" rel="noopener noreferrer">
      Open PDF <span class="sr-only">in a new tab</span> ↗
    </a>

    <a href={resumeUrl} download="Michael_Luong_Resume.pdf">
      Download PDF ↓
    </a>
  </div>

  <object
    data={resumeUrl}
    type="application/pdf"
    aria-label="Michael Luong’s resume"
  >
    <p>
      You can <a href={resumeUrl}>open the résumé PDF</a>
      to read it in your browser.
    </p>
  </object>
</section>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  a {
    color: #a4ffdc;
    text-underline-offset: 0.25em;
  }

  .actions a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    box-sizing: border-box;
    padding: 0.6rem 1rem;
    border: 1px solid #36485f;
    border-radius: 8px;
    background: #151f30;
    text-decoration: none;
  }

  .actions a:hover {
    border-color: #a4ffdc;
    background: #1c3341;
  }

  a:focus-visible {
    outline: 2px solid #a4ffdc;
    outline-offset: 3px;
  }

  object {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: 75vh;
    min-height: 450px;
    border: 1px solid #36485f;
    border-radius: 10px;
    background: #151f30;
  }

  object p {
    padding: 1rem;
    color: #b5c7e1;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>