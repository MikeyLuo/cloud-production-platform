---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const links = [
  {
    name: "Email Michael",
    title: "Email",
    href: "mailto:michaeltriluong@gmail.com",
    path: "M3 5h18v14H3z M3 5l9 7 9-7",
    brand: false,
  },
  {
    name: "GitHub profile",
    title: "GitHub",
    href: "https://github.com/mikeyluo",
    path: "M12 .8a11.2 11.2 0 0 0-3.54 21.83c.56.1.76-.24.76-.54v-2.09c-3.12.68-3.78-1.33-3.78-1.33-.51-1.3-1.25-1.64-1.25-1.64-1.02-.7.08-.68.08-.68 1.13.08 1.72 1.16 1.72 1.16 1 1.71 2.62 1.22 3.26.93.1-.72.39-1.22.71-1.5-2.49-.28-5.11-1.25-5.11-5.54 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.95 0 0 .94-.3 3.08 1.15a10.72 10.72 0 0 1 5.61 0c2.14-1.45 3.08-1.15 3.08-1.15.61 1.53.23 2.67.11 2.95.72.78 1.15 1.78 1.15 3 0 4.3-2.63 5.25-5.13 5.53.4.35.76 1.03.76 2.08v3.08c0 .3.2.65.77.54A11.2 11.2 0 0 0 12 .8z",
    brand: true,
  },
  {
    name: "LinkedIn profile",
    title: "LinkedIn",
    href: "https://www.linkedin.com/in/michael-luong-695751165/",
    path: "M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52zM7.93 18.75H4.98V9.2h2.95v9.55zM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42zm12.3 10.85H15.8V14.1c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.5V9.2h2.84v1.31h.04c.4-.75 1.36-1.55 2.79-1.55 2.99 0 3.58 1.97 3.58 4.53v5.26z",
    brand: true,
  },
  {
    name: "Home",
    title: "Home",
    href: `${base}/`,
    path: "M3 10l9-7 9 7 M5 9v12h5v-7h4v7h5V9",
    brand: false,
  },
];
---

<nav aria-label="Contact and home">
  <ul>
    {links.map((link) => (
      <li>
        <a href={link.href} aria-label={link.name} title={link.title}>
          <svg
            viewBox="0 0 24 24"
            width="19"
            height="19"
            aria-hidden="true"
            fill={link.brand ? "currentColor" : "none"}
            stroke={link.brand ? "none" : "currentColor"}
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d={link.path} />
          </svg>
        </a>
      </li>
    ))}
  </ul>
</nav>
<style>
  ul {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: #a8b6c5;
    border-radius: 6px;
  }
  a:hover {
    color: #a4ffdc;
    background: #20312e;
  }
  a:focus-visible {
    outline: 2px solid #a4ffdc;
    outline-offset: 2px;
  }
</style>
