---
import ContactLinks from "../components/ContactLinks.astro";
import PageViewCounter from "../components/PageViewCounter.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resumeUrl = `${base}/documents/Michael_Luong_Resume.pdf`;
const tabs = [
  { id: "home", label: "~/home" },
  { id: "projects", label: "~/projects" },
  { id: "experience", label: "~/experience" },
  { id: "skills", label: "~/skills" },
  { id: "about", label: "~/about" },
];
const skills = [
  {
    title: "Cloud & infrastructure",
    tools: ["AWS", "Terraform", "Docker", "Kubernetes", "EKS", "Helm"],
  },
  {
    title: "Delivery & observability",
    tools: ["GitHub Actions", "Jenkins", "Prometheus", "Datadog"],
  },
  {
    title: "Code & systems",
    tools: ["Python", "Bash", "Go", "SQL", "Linux", "HTTP / TCP/IP"],
  },
];
const countries = [
  "Peru",
  "Greece",
  "Ireland",
  "Thailand",
  "Philippines",
  "Vietnam",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Michael Luong’s cloud and DevOps portfolio. Explore AWS infrastructure, Python backends, deployment pipelines, and stories from the road."
    />
    <title>Michael Luong | Cloud & DevOps</title>
  </head>
  <body>
    <a class="skip-link" href="#content">
      Skip to content
    </a>
    <div class="terminal-window">
      <header class="window-bar">
        <a
          class="window-home"
          href={`${base}/`}
          aria-label="Michael Luong, home"
        >
          <span class="window-lights" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
          </span>
          <span>
            michael@portfolio<span class="path">: ~</span>
          </span>
        </a>
        <ContactLinks />
      </header>
      <nav class="section-nav" aria-label="Portfolio sections">
        <ul>
          {tabs.map((tab) => (
            <li>
              <a
                href={`#${tab.id}`}
                data-section-link={tab.id}
                aria-current={tab.id === "home" ? "location" : undefined}
              >
                {tab.label}
              </a>
            </li>
          ))}
          <li>
            <a href={`${base}/travel/`}>~/travel</a>
          </li>
        </ul>
      </nav>
      <main id="content">
        <section id="home" class="hero" aria-labelledby="name">
          <div class="hero-copy">
            <p class="command">
              <span aria-hidden="true">$ </span>whoami
            </p>
            <p class="eyebrow">Software engineer · Cloud & DevOps</p>
            <h1 id="name">
              Michael <span>Luong</span>
              <span class="cursor" aria-hidden="true"></span>
            </h1>
            <p class="hero-description">
              I build software, automate deployments, and connect the pieces
              that keep applications running.
            </p>
            <p class="hero-detail">
              Software engineering graduate with DevOps experience.
              <br />
              Based in London, Ontario.
            </p>
            <div class="actions">
              <a class="button primary" href="#projects">
                Explore projects
              </a>
              <a
                class="button"
                href={resumeUrl}
                download="Michael_Luong_Resume.pdf"
              >
                Download résumé <span class="file-type">PDF</span>
              </a>
            </div>
          </div>
          <aside class="profile-card" aria-label="Michael’s focus">
            <div class="monogram" aria-hidden="true">
              ML<span>_</span>
            </div>
            <p class="profile-name">Michael Luong</p>
            <p class="mono">Build. Observe. Improve.</p>
            <div class="profile-tags">
              <span>AWS</span>
              <span>Python</span>
              <span>Terraform</span>
            </div>
            <a class="profile-contact" href="mailto:michaeltriluong@gmail.com">
              Let’s connect
            </a>
          </aside>
        </section>

        <div class="evidence" aria-label="Implemented in this portfolio">
          <div>
            <span class="evidence-label">Hosting</span>
            <strong>Public & deployed</strong>
            <span>GitHub Pages + Actions</span>
          </div>
          <div>
            <span class="evidence-label">Backend</span>
            <strong>Live AWS counter</strong>
            <span>API Gateway · Lambda · DynamoDB</span>
          </div>
          <div>
            <span class="evidence-label">Infrastructure</span>
            <strong>Managed with Terraform</strong>
            <span>Versioned remote state in S3</span>
          </div>
        </div>

        <section id="projects" aria-labelledby="projects-title">
          <div class="section-heading">
            <div>
              <p class="command">$ ls projects/</p>
              <h2 id="projects-title">
                Built to understand
                <br class="desktop-break" /> how things work.
              </h2>
            </div>
            <p class="section-note">
              A closer look at the systems
              <br />
              behind the repositories.
            </p>
          </div>
          <article class="project featured-project">
            <div class="project-copy">
              <p class="project-category">
                Cloud infrastructure · In development
              </p>
              <h3>Cloud Production Platform</h3>
              <p>
                The portfolio you’re exploring. A static frontend connected to a
                Python backend, with infrastructure defined in Terraform.
              </p>
              <ul class="project-details">
                <li>Live page-view counter with atomic DynamoDB updates.</li>
                <li>GitHub Actions builds and publishes the website.</li>
                <li>Encrypted, versioned S3 state with Terraform locking.</li>
              </ul>
              <p class="upcoming">
                Next in the build — OIDC deployments and an S3 / CloudFront
                travel blog.
              </p>
              <div class="project-links">
                <a href="https://github.com/MikeyLuo/cloud-production-platform">
                  View repository
                </a>
                <a href={`${base}/projects/`}>Project details</a>
              </div>
            </div>
            <div
              class="architecture"
              aria-label="Counter request flow, browser to API Gateway to Python Lambda to DynamoDB"
            >
              <p class="diagram-label">Inside the visitor counter</p>
              <ol>
                <li>
                  <span class="node-icon" aria-hidden="true">
                    &gt;_
                  </span>
                  <div>
                    <strong>Browser</strong>
                    <span>Record a page view</span>
                  </div>
                </li>
                <li>
                  <span class="node-icon" aria-hidden="true">
                    &#123; &#125;
                  </span>
                  <div>
                    <strong>API Gateway</strong>
                    <span>POST /views</span>
                  </div>
                </li>
                <li>
                  <span class="node-icon" aria-hidden="true">
                    λ
                  </span>
                  <div>
                    <strong>Python Lambda</strong>
                    <span>Increment the counter</span>
                  </div>
                </li>
                <li>
                  <span class="node-icon" aria-hidden="true">
                    ≡
                  </span>
                  <div>
                    <strong>DynamoDB</strong>
                    <span>Store the updated total</span>
                  </div>
                </li>
              </ol>
              <span class="diagram-caption">Provisioned with Terraform</span>
            </div>
          </article>
          <article class="project stream-project">
            <div>
              <p class="project-category">
                Event-driven systems · Local cloud emulation
              </p>
              <h3>StreamPulse</h3>
              <p>
                A streaming-event backend built with Python, Kinesis, Lambda,
                DynamoDB, and S3. Developed and tested locally using Floci.
              </p>
              <ul class="project-details">
                <li>Asynchronous playback-event processing and archiving.</li>
                <li>Concurrency and pause / recovery checks.</li>
                <li>Repeatable infrastructure and GitHub Actions checks.</li>
              </ul>
              <div class="project-links">
                <a href="https://github.com/MikeyLuo/Event-Driven-Archtiecture">
                  View repository
                </a>
              </div>
            </div>
            <div
              class="event-flow"
              aria-label="Playback events processed asynchronously"
            >
              <p class="diagram-label">Playback event pipeline</p>
              <div class="event-code">
                <span class="code-muted">&#123;</span>
                <br />
                &nbsp; <span class="code-key">"event"</span>:{" "}
                <span>"playback"</span>,<br />
                &nbsp; <span class="code-key">"processing"</span>:{" "}
                <span>"async"</span>
                <br />
                <span class="code-muted">&#125;</span>
              </div>
              <p>
                Ingest events.
                <br />
                Process independently.
                <br />
                Persist the result.
              </p>
            </div>
          </article>
        </section>

        <section id="experience" aria-labelledby="experience-title">
          <div class="section-heading">
            <div>
              <p class="command">$ git log --experience</p>
              <h2 id="experience-title">Experience in delivery.</h2>
            </div>
            <a class="text-link" href={resumeUrl}>
              Open full résumé
            </a>
          </div>
          <article class="experience-card">
            <div class="experience-meta">
              <span class="experience-date">Sep 2021 — Sep 2022</span>
              <h3>Prodigy Education</h3>
              <p>DevOps Developer</p>
              <span class="location">Oakville, Ontario</span>
            </div>
            <ul>
              <li>
                Built and automated delivery pipelines with GitHub Actions.
              </li>
              <li>
                Deployed containerized services on AWS EKS across development,
                testing, and production.
              </li>
              <li>Managed EC2 configurations and Terraform infrastructure.</li>
              <li>
                Maintained Datadog and Prometheus monitoring, and automated
                stale Docker-image cleanup in Artifactory.
              </li>
            </ul>
          </article>
        </section>

        <section id="skills" aria-labelledby="skills-title">
          <div class="section-heading">
            <div>
              <p class="command">$ cat toolkit</p>
              <h2 id="skills-title">Tools I work with.</h2>
            </div>
          </div>
          <div class="skill-grid">
            {skills.map((group) => (
              <article class="skill-card">
                <h3>{group.title}</h3>
                <ul>
                  {group.tools.map((tool) => (
                    <li>{tool}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </section>

        <section id="about" class="about-section" aria-labelledby="about-title">
          <div>
            <p class="command">$ cat about.md</p>
            <h2 id="about-title">
              Curiosity is the
              <br />
              common thread.
            </h2>
          </div>
          <div class="about-copy">
            <p>
              I’m a software engineering graduate building my career in cloud
              engineering and DevOps. I enjoy automating repetitive work,
              understanding how systems fit together, and troubleshooting
              problems.
            </p>
            <p>
              I learn by building, testing, and documenting what happens along
              the way. Away from the terminal, that curiosity takes me traveling
              and trying local food.
            </p>
            <p class="education">
              Bachelor of Engineering Science, Software Engineering
              <br />
              <strong>Western University</strong>
            </p>
          </div>
        </section>

        <section class="travel-card" aria-labelledby="travel-title">
          <div>
            <p class="project-category">Away from the terminal</p>
            <h2 id="travel-title">A different kind of exploration.</h2>
            <p>
              Places I’ve visited, food I’ve tried, and stories from the road.
            </p>
            <ul class="countries" aria-label="Countries visited">
              {countries.map((country) => (
                <li>{country}</li>
              ))}
            </ul>
            <a class="button" href={`${base}/travel/`}>
              Open Field Atlas
            </a>
          </div>
          <div class="travel-mark" aria-hidden="true">
            <span>
              FIELD
              <br />
              ATLAS
            </span>
            <span class="compass">✦</span>
            <span class="atlas-caption">Six countries. More to discover.</span>
          </div>
        </section>
      </main>
      <footer>
        <div>
          <span class="footer-prompt" aria-hidden="true">
            &gt;_
          </span>{" "}
          Michael Luong <span class="footer-role">· Cloud & DevOps</span>
        </div>
        <PageViewCounter />
        <a href="#home">Back to top</a>
      </footer>
    </div>
  </body>
</html>
<script>
  const links = document.querySelectorAll<HTMLAnchorElement>(
    "[data-section-link]",
  );
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          for (const link of links) {
            if (link.dataset.sectionLink === entry.target.id)
              link.setAttribute("aria-current", "location");
            else link.removeAttribute("aria-current");
          }
        }
      }
    },
    { rootMargin: "-20% 0px -65% 0px", threshold: 0 },
  );
  for (const link of links) {
    const section = document.getElementById(link.dataset.sectionLink ?? "");
    if (section) observer.observe(section);
  }
</script>
<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(html) {
    scroll-padding-top: 90px;
  }
  :global(body) {
    margin: 0;
    background: #090e12;
    color: #eef3f7;
    font:
      16px/1.65 "Geist",
      "Segoe UI",
      Arial,
      sans-serif;
  }
  :global(::selection) {
    background: #a4ffdc;
    color: #101d19;
  }
  :global(a:focus-visible) {
    outline: 2px solid #a4ffdc;
    outline-offset: 5px;
    border-radius: 3px;
  }
  .terminal-window {
    --muted: #a6b3c2;
    --mint: #a4ffdc;
    --line: #28343f;
    --mono: "IBM Plex Mono", "Consolas", monospace;
    max-width: 1160px;
    margin: 32px auto;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: #10171e;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  .window-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 24px;
    border-bottom: 1px solid var(--line);
    background: #151d25;
    border-radius: 14px 14px 0 0;
  }
  .window-home {
    display: flex;
    gap: 22px;
    align-items: center;
    font: 13px/1.5 var(--mono);
    color: #c1ccd7;
  }
  .path {
    color: #8395a5;
  }
  .window-lights {
    display: flex;
    gap: 8px;
  }
  .window-lights i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #fb7169;
  }
  .window-lights i:nth-child(2) {
    background: #eac265;
  }
  .window-lights i:nth-child(3) {
    background: #79c49b;
  }
  .section-nav {
    position: sticky;
    top: 0;
    z-index: 5;
    background: #10171ef5;
    border-bottom: 1px solid var(--line);
    border-top: 1px solid transparent;
    border-radius: 0;
    backdrop-filter: blur(12px);
  }
  .section-nav ul {
    display: flex;
    overflow-x: auto;
    margin: 0;
    padding: 0 24px;
    list-style: none;
  }
  .section-nav a {
    display: block;
    padding: 14px 20px;
    border-bottom: 2px solid transparent;
    border-right: 1px solid #202b34;
    font: 14px/1.5 var(--mono);
    color: #a9b6c3;
    white-space: nowrap;
  }
  .section-nav a:hover,
  .section-nav a[aria-current] {
    color: var(--mint);
    background: #172420;
    border-bottom-color: var(--mint);
  }
  main {
    padding: 0 48px;
  }
  section {
    scroll-margin-top: 12px;
  }
  main > section {
    margin-top: 76px;
  }
  main > section.hero {
    margin-top: 0;
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 44px;
    align-items: center;
    padding: 54px 0 38px;
  }
  .command {
    color: var(--mint);
    font: 13px/1.5 var(--mono);
    margin: 0 0 20px;
  }
  .eyebrow {
    color: #c1ccd5;
    font-size: 14px;
    margin: 0 0 8px;
  }
  h1 {
    font-size: clamp(42px, 6.5vw, 70px);
    line-height: 1.08;
    letter-spacing: -0.06em;
    margin: 0 0 20px;
    font-weight: 650;
  }
  h1 > span:first-child {
    color: var(--mint);
  }
  .cursor {
    display: inline-block;
    width: 8px;
    height: 0.7em;
    margin-left: 8px;
    background: var(--mint);
  }
  .hero-description {
    font-size: 20px;
    line-height: 1.6;
    max-width: 580px;
    color: #d1dae3;
    margin: 0 0 16px;
  }
  .hero-detail {
    color: var(--muted);
    font-size: 14px;
    margin: 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }
  .button {
    display: inline-flex;
    gap: 12px;
    align-items: center;
    justify-content: center;
    padding: 11px 18px;
    min-height: 46px;
    border: 1px solid #40524f;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 550;
    background: #17232a;
  }
  .button:hover {
    border-color: var(--mint);
    background: #21312e;
  }
  .button.primary {
    background: var(--mint);
    color: #10251e;
    border-color: var(--mint);
  }
  .button.primary:hover {
    background: #ceffeb;
  }
  .file-type {
    font: 11px var(--mono);
    opacity: 0.7;
  }
  .profile-card {
    border: 1px solid #34443e;
    border-radius: 10px;
    padding: 26px 20px 20px;
    background: radial-gradient(ellipse at top, #223e33 0, #14221d 75%);
    text-align: center;
  }
  .monogram {
    font:
      60px/1.5 Georgia,
      serif;
    letter-spacing: -7px;
    color: #b4e4cd;
    margin-bottom: 20px;
  }
  .monogram span {
    color: #7dbea4;
    font: 36px var(--mono);
  }
  .profile-name {
    font-weight: 600;
    margin: 0;
  }
  .mono {
    font: 12px/1.6 var(--mono);
    color: #a6c3b6;
    margin: 4px 0 20px;
  }
  .profile-tags {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px;
  }
  .profile-tags span {
    border: 1px solid #395346;
    border-radius: 4px;
    padding: 3px 7px;
    font: 11px/1.6 var(--mono);
    color: #bbd3c8;
  }
  .profile-contact {
    display: block;
    color: var(--mint);
    font-size: 13px;
    margin-top: 24px;
    padding-top: 14px;
    border-top: 1px solid #304638;
  }
  .evidence {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #141e26;
  }
  .evidence > div {
    display: flex;
    flex-direction: column;
    padding: 20px;
    gap: 5px;
  }
  .evidence > div + div {
    border-left: 1px solid var(--line);
  }
  .evidence-label {
    font: 11px/1.5 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #8da599;
  }
  .evidence strong {
    font-size: 16px;
    font-weight: 550;
  }
  .evidence > div > span:last-child {
    font-size: 12px;
    color: var(--muted);
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 26px;
  }
  .section-heading .command {
    margin-bottom: 12px;
  }
  h2 {
    font-size: clamp(28px, 3.4vw, 38px);
    line-height: 1.22;
    font-weight: 550;
    letter-spacing: -0.035em;
    margin: 0;
  }
  .section-note {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.6;
    margin: 0 0 3px;
  }
  h3 {
    font-size: 24px;
    line-height: 1.3;
    font-weight: 550;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }
  .project {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 34px;
    border: 1px solid var(--line);
    padding: 32px;
    border-radius: 10px;
    background: #141e27;
  }
  .project + .project {
    margin-top: 18px;
  }
  .featured-project {
    border-color: #3a574d;
    background: linear-gradient(120deg, #16252a, #131d26 80%);
  }
  .project-category {
    font: 12px/1.6 var(--mono);
    color: var(--mint);
    margin: 0 0 14px;
  }
  .project p:not(.project-category):not(.diagram-label) {
    font-size: 15px;
    color: #b9c6d2;
  }
  .project-details {
    margin: 20px 0;
    padding-left: 18px;
    font-size: 14px;
    color: #b9c6d2;
  }
  .project-details li {
    padding-left: 3px;
    margin: 7px 0;
  }
  .project-details li::marker {
    color: #72ad98;
  }
  .project p.upcoming {
    color: #94aca4;
    font-size: 13px;
  }
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 22px;
    font-size: 14px;
    color: var(--mint);
  }
  .project-links a,
  .text-link {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-color: #57746b;
  }
  .project-links a:hover,
