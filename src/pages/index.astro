    text-decoration-color: var(--mint);
  }
  .architecture {
    border: 1px solid #344a43;
    border-radius: 7px;
    padding: 20px;
    background: #0e181e;
  }
  .diagram-label {
    font: 11px/1.6 var(--mono);
    color: #95aea3;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 18px;
  }
  .architecture ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .architecture li {
    display: flex;
    gap: 14px;
    position: relative;
    padding-bottom: 20px;
  }
  .architecture li:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 38px;
    left: 18px;
    height: 20px;
    border-left: 1px solid #3f6253;
  }
  .node-icon {
    display: grid;
    place-items: center;
    flex: 0 0 38px;
    height: 38px;
    border: 1px solid #3a594b;
    background: #1b2e25;
    border-radius: 6px;
    color: var(--mint);
    font: 16px var(--mono);
  }
  .architecture li div {
    display: flex;
