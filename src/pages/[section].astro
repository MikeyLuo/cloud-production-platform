---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import FieldAtlas from '../components/FieldAtlas.astro';

export function getStaticPaths() {
  return [
    { params: { section: 'about' }, props: { title: 'About Me' } },
    { params: { section: 'resume' }, props: { title: 'Resume' } },
    { params: { section: 'projects' }, props: { title: 'Projects' } },
    { params: { section: 'travel' }, props: { title: 'Travel Blog' } },
  ];
}

const { title } = Astro.props;
const section = Astro.params.section ?? '';
---

<PortfolioLayout title={title} section={section}>
  {section === 'travel' && <FieldAtlas />}
</PortfolioLayout>