---
export function getStaticPaths() {
  return [
    { params: { section: 'about' }, props: { title: 'About Me' } },
    { params: { section: 'resume' }, props: { title: 'Resume' } },
    { params: { section: 'projects' }, props: { title: 'Projects' } },
    { params: { section: 'travel' }, props: { title: 'Travel Blog' } },
  ];
}

const { title } = Astro.props;
const isTravel = Astro.params.section === 'travel';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Michael Luong</title>
  </head>
  <body>
    <main>
      <a href="/">← Mission Control</a>
      <h1>{title}</h1>
      {isTravel && (
        <p>Field Atlas will feature Peru, Greece, Ireland, Thailand, the Philippines, and Vietnam.</p>
      )}
    </main>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background: #0b1018;
    color: #edf4ff;
    font: 1rem/1.55 system-ui, sans-serif;
  }

  main { max-width: 56rem; margin: 0 auto; padding: 3rem 1.25rem; }
  a { color: #75f2be; }
</style>